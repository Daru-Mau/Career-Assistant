{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/context/architecture.md",
    "docs/context/conventions.md",
    "docs/context/decisions.md",
    "docs/context/glossary.md",
    "docs/context/workflow.md",
    "docs/context/known-errors.md",
    "docs/context/automation-guardrails.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "mkdir *": "ask",
      "mkdir *applications/*": "allow",
      "mkdir *job_offers/*": "allow",
      "mkdir *tracking/*": "allow",
      "python3 -m scripts.jobs.cli *": "allow",
      "scripts/scheduler/run_pipeline.sh *": "allow",
      "python3 -m scripts.jobs.cli *submit*": "ask",
      "python3 -m scripts.jobs.cli *apply*": "ask",
      "rm *": "deny",
      "npm *": "deny"
    },
    "edit": {
      "*": "ask",
      "applications/**": "allow",
      "job_offers/**": "allow",
      "tracking/**": "allow",
      "discoveries/**": "allow"
    }
  }
}
